<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- No library dependencies (the zstd decoder is vendored source). nuget.org is listed because a Native AOT
       build with Microsoft's .NET SDK downloads the AOT compiler package from it; distro SDKs (e.g. Ubuntu's
       dotnet-sdk-aot-10.0) ship that compiler and build offline. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
